@page "/admin/personalizar"
@layout AdminLayout
@inject IAppearanceService AppearanceService
@inject ThemeService ThemeService

<section class="view appearance-grid">
    <div>
        <div class="section-title">
            <h2>Personalizacion de Marca</h2>
            <p>Cambia el estilo visual de tu app. Por ahora se guarda en memoria.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(SuccessMessage))
        {
            <div class="success-message">@SuccessMessage</div>
        }

        <div class="panel settings-card">
            <div class="field">
                <label for="businessName">Nombre Comercial</label>
                <input id="businessName" class="form-input" type="text" @bind="Settings.BusinessName" />
            </div>

            <div class="field">
                <label for="brandColor">Color de Marca</label>
                <div class="color-box">
                    <input id="brandColor" type="color" value="@Settings.PrimaryColor" @oninput="PreviewColorAsync" />
                    <div>
                        <strong>@Settings.PrimaryColor</strong>
                        <p>Este color define el header, botones y acentos.</p>
                    </div>
                </div>
            </div>

            <div class="field">
                <label for="bannerText">Mensaje Promocional</label>
                <textarea id="bannerText" class="form-textarea" @bind="Settings.BannerText"></textarea>
            </div>

            <button class="dark-button" type="button" @onclick="Save">Guardar Configuracion</button>
        </div>
    </div>

    <BrandPreview PrimaryColor="@Settings.PrimaryColor" />
</section>

@code {
    private AppearanceSettings Settings { get; set; } = new();
    private string SuccessMessage { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        Settings = new AppearanceSettings
        {
            PrimaryColor = AppearanceService.Current.PrimaryColor,
            BusinessName = AppearanceService.Current.BusinessName,
            Slogan = AppearanceService.Current.Slogan,
            BannerText = AppearanceService.Current.BannerText,
            LogoUrl = AppearanceService.Current.LogoUrl
        };
    }

    private async Task Save()
    {
        AppearanceService.Update(Settings);
        await ThemeService.ApplyAsync(Settings.PrimaryColor);
        SuccessMessage = "Configuracion actualizada con exito.";
    }

    private async Task PreviewColorAsync(ChangeEventArgs args)
    {
        Settings.PrimaryColor = args.Value?.ToString() ?? Settings.PrimaryColor;
        SuccessMessage = string.Empty;
        await ThemeService.ApplyAsync(Settings.PrimaryColor);
        StateHasChanged();
    }
}
