@inject IAppearanceService AppearanceService
@inject CartService CartService
@inject NavigationManager NavigationManager

@implements IDisposable

<header class="store-header">
    <div class="store-header-inner">
        <button class="hidden-admin-trigger" type="button" @onclick="HandleClick" aria-label="Logo de Salud y Vida">
            @* <img src="assets/lnw3.png" alt="" /> *@
            <img class="store-logo" src="@AppearanceService.Current.LogoUrl" alt="@AppearanceService.Current.BusinessName" />
        </button>
        @* <img class="store-logo" src="@AppearanceService.Current.LogoUrl" alt="@AppearanceService.Current.BusinessName" /> *@
        @* <div class="store-actions">
            <div class="store-bag" aria-label="Carrito">
                <span>Bolsa</span>
                <strong>Carrito</strong>
                @if (CartService.Count > 0)
                {
                    <span class="cart-count">@CartService.Count</span>
                }
            </div>
        </div> *@
    </div>
</header>

@code {
    protected override void OnInitialized()
    {
        CartService.Changed += StateHasChanged;
        AppearanceService.Changed += StateHasChanged;
    }

    public void Dispose()
    {
        CartService.Changed -= StateHasChanged;
        AppearanceService.Changed -= StateHasChanged;
    }


    private DateTime lastClickTime = DateTime.MinValue;
    private const double DoubleTapDelayMs = 300; // Margen de tiempo en milisegundos

    private void HandleClick()
    {
        var currentTime = DateTime.UtcNow;
        var timeSpan = currentTime - lastClickTime;

        if (timeSpan.TotalMilliseconds <= DoubleTapDelayMs)
        {
            // ¡Es un doble click/tap exitoso!
            OpenAdmin();
        }

        // Guardamos el momento de este click para el siguiente intento
        lastClickTime = currentTime;
    }


    private void OpenAdmin()
    {
        NavigationManager.NavigateTo("/admin");
    }

}
