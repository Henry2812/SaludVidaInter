@inject AuthService AuthService
@inject NavigationManager NavigationManager

<header class="admin-header">
    <div>
        <h1>Dashboard de Administracion</h1>
        <div class="connection">
            <span>Web</span>
            <span>Conectado:</span>
            <strong>saludyvidainter.site</strong>
        </div>
    </div>

    <div class="header-actions">
        @* <div class="mini-stat">
            <span>Ultima venta</span>
            <strong>$00.00</strong>
        </div> *@
        <div class="avatar" aria-label="Usuario">SV</div>
        <button class="logout-button" type="button" @onclick="LogoutAsync">Salir</button>
    </div>
</header>

@code {
    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/admin/login", replace: true);
    }
}
