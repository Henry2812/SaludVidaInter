@inject CartService CartService
@using System.Globalization;

<article class="client-card">
    <div class="client-image">
        <img src="@Product.ImageUrl" alt="@Product.Name" />
        <button class="client-add" type="button" @onclick="AddToCart" aria-label="Agregar @Product.Name">+</button>
    </div>
    <div class="client-info">
        <span>@Product.Category</span>
        <h3>@Product.Name</h3>
        <p>@Product.Description</p>
        <div class="price-row">
            <div class="price">@Product.Price.ToString("C", CultureInfo.CreateSpecificCulture("en-US"))</div>
            <small>@Product.Stock disp.</small>
        </div>
        <div class="payment-links">
            <a class="stripe-link" href="https://buy.stripe.com/bJe14gcou57efjbeSO7Vm01" target="_blank" rel="noopener noreferrer">Compra aqui</a>
            <a class="paypal-link" href="https://www.paypal.me/PagoMedicamento" target="_blank" rel="noopener noreferrer">PayPal</a>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Product Product { get; set; } = default!;

    private void AddToCart()
    {
        CartService.Add(Product);
    }
}
